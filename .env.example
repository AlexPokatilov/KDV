# Whether to use in-cluster ServiceAccount token instead of kubeconfig
IN_CLUSTER=false

# Path to kubeconfig file (defaults to ~/.kube/config when empty)
KUBECONFIG_PATH=

# Uvicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info

# Path to built frontend static assets (set automatically in Docker)
STATIC_DIR=/app/static

# Allowed CORS origins (JSON array). Use ["*"] for open access in development only.
CORS_ORIGINS=["*"]
